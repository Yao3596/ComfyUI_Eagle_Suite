lized_name":"交付画面","name":"images","shape":7,"type":"IMAGE","link":49},{"localized_name":"采样 AV Latent","name":"sampled_latent","shape":7,"type":"LATENT","link":48},{"name":"decision","type":"STRING","shape":7,"link":37},{"name":"filename","type":"STRING"},{"name":"format","type":"STRING"},{"name":"fps_override","type":"INT"},{"name":"local_save_path","type":"STRING"},{"name":"eagle_folder","type":"STRING"},{"localized_name":"自动装配","name":"auto_assemble","shape":7,"type":"BOOLEAN","widget":{"name":"auto_assemble"},"link":null}],"outputs":[{"name":"state","type":"EAGLE_H3_STATE","links":[]},{"name":"video","type":"VIDEO","links":[]},{"name":"done","type":"BOOLEAN","links":[]},{"name":"next_index","type":"INT","links":[]},{"name":"summary","type":"STRING","links":[]},{"localized_name":"运行清单","name":"manifest","type":"EAGLE_H3_MANIFEST","links":[]},{"localized_name":"是否部分成片","name":"partial","type":"BOOLEAN","links":[]},{"localized_name":"末镜上下文帧","name":"last_context_frames","type":"IMAGE","links":[]},{"localized_name":"末镜 AV Latent","name":"last_context_latent","type":"LATENT","links":[]}],"properties":{"Node name for S&R":"EagleH3NativeLoopEndNode"},"widgets_values":[true,"","","mp4",0,"",""],"title":"🦅 H3 · 循环结束 + 自动合成","color":"#2d4a2d","bgcolor":"rgba(24,24,27,.9)"},{"id":24,"type":"Note","pos":[-2450,-1100],"size":[1550,220],"flags":{},"order":23,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"Note"},"widgets_values":["EAGLE H3 全套工作流（Eagle 原生循环）\n\n1. 先确认左侧四个模型名称与本机路径一致。\n2. 在 H3 导演台添加任意数量场景，并添加图片/视频/音频参考。\n3. media_bundle 只需一条线接入“参考条件路由”；它会按当前场景标签拆成官方 H3 Autogrow 插槽，不要把参考图拼成宫格。\n4. 镜头与上下文的 raw_frames 必须连接参考条件路由的 length；它会逐镜传递真实帧数，不能固定为 124。\n5. 替换“首镜起始帧”；续镜会自动读取上一镜检查点并作为 Guide 注入。\n6. VAE 解码帧和音频先进入“重叠帧与音频裁剪”，去除重复首帧并校正音画长度，再直接送入分段保存与审片。\n7. mode=auto 一次 Queue 跑完全部场景；interactive 每镜停留审片。\n8. 不要把 Eagle 的 EAGLE_H3_STATE 接到第三方 H3_CHAIN_STATE。若需第三方编辑预览，请从导演台右键创建 Context Loop 兼容编辑链。\n9. 最后一镜通过后自动合成，可同时复制到本地目录并导入 Eagle 文件夹。\n10. 导演台时长是精确剪辑时长；H3 会向上取 17k+5 合法生成帧，并由 target_frames 自动裁掉尾部多余帧。\n11. 16GB 工作流已启用 Chunk FeedForward（4 块）；顶部尺寸状态栏显示的宽高和帧数才是实际执行值。"],"title":"使用说明","color":"#432f66","bgcolor":"rgba(24,24,27,.9)"},{"id":25,"type":"Note","pos":[2620,-240],"size":[1090,210],"flags":{},"order":24,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"Note"},"widgets_values":["审片与恢复\n\n• auto 模式默认通过并继续，适合一次生成全部场景。\n• interactive 模式可在右侧预览后选择通过、按原提示重试、换种子重抽或停止。\n• resume_policy=resume 会从已保存检查点续跑；overwrite 会重建同名任务。\n• 最终视频从“循环结束 + 自动合成”的 video 输出取得，分镜片段与清单保存在 ComfyUI/output/h3_eagle_chains。"],"title":"审片 / 重试 / 断点续跑","color":"#432f66","bgcolor":"rgba(24,24,27,.9)"},{"id":26,"type":"MiniMaxChunkFeedForward","pos":[460.0,-130.0],"size":[280,120],"flags":{},"order":25,"mode":0,"inputs":[{"name":"model","type":"MODEL","link":17},{"name":"chunks","type":"INT","widget":{"name":"chunks"}},{"name":"seq_threshold","type":"INT","widget":{"name":"seq_threshold"}}],"outputs":[{"name":"model","type":"MODEL","links":[46,19]}],"properties":{"cnr_id":"comfyui-kjnodes","Node name for S&R":"MiniMaxChunkFeedForward"},"widgets_values":[4,4096],"widgets_values_named":{"chunks":4,"seq_threshold":4096},"title":"16GB 显存安全·Chunk FeedForward"}],"links":[[1,5,0,7,6],[2,6,3,7,3],[3,7,0,9,0],[5,9,0,23,0],[6,9,1,10,0],[7,11,0,10,2],[8,2,0,12,0],[9,3,0,12,1],[10,10,1,12,5],[11,9,2,12,6],[12,9,3,12,7],[13,10,4,12,8],[14,10,10,12,12],[15,1,0,13,0],[16,10,2,14,0],[17,13,0,26,0],[18,12,0,16,1],[19,26,0,17,0],[20,10,3,17,1],[21,14,0,18,0],[22,16,0,18,1],[23,15,0,18,2],[24,17,0,18,3],[25,12,1,18,4],[26,18,0,19,0],[27,3,0,19,1],[28,18,0,20,0],[29,4,0,20,1],[30,19,0,21,0],[31,9,4,21,3],[32,20,0,21,2],[33,10,0,22,0],[35,21,1,22,3],[36,22,1,23,1],[37,22,2,23,4],[38,4,0,12,2],[39,7,6,12,3],[40,10,0,12,4],[41,10,12,12,13],[42,12,5,21,1],[43,21,0,22,2],[44,21,2,22,4],[45,10,5,21,6,"INT"],[46,26,0,16,0,"MODEL"],[47,18,0,22,5,"LATENT"],[48,18,0,23,3,"LATENT"],[49,21,0,23,2,"IMAGE"]],"groups":[{"id":1,"title":"① 模型与 VAE","bounding":[-2500,-900,500,